{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moooyo.github.io/5gpn-extensions/marketplace/v2/schema.json",
  "title": "5gpn Extension Marketplace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "entries"
  ],
  "properties": {
    "apiVersion": {
      "const": "5gpn.io/marketplace/v1"
    },
    "kind": {
      "const": "ExtensionMarketplace"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "repositoryRawUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/moooyo/5gpn-extensions/[0-9a-f]{40}/"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "homepage",
        "source"
      ],
      "properties": {
        "id": {
          "const": "io.5gpn.official"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "homepage": {
          "$ref": "#/$defs/httpsUrl"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "const": "https://github.com/moooyo/5gpn-extensions"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "description",
        "tags",
        "license",
        "documentationUrl",
        "manifest",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{1,38}[a-z0-9])$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdx",
            "url"
          ],
          "properties": {
            "spdx": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
            },
            "url": {
              "$ref": "#/$defs/repositoryRawUrl"
            }
          }
        },
        "documentationUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/moooyo/5gpn-extensions/blob/[0-9a-f]{40}/"
        },
        "manifest": {
          "$ref": "#/$defs/artifact"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/repositoryRawUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureHostCount",
        "actionCount",
        "settingCount",
        "network",
        "persistentStorage",
        "upstreamMappingCount",
        "routingRuleCount",
        "egressGroupRequired"
      ],
      "properties": {
        "captureHostCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "actionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "settingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "network": {
          "description": "The network grant. It names no origins: an extension holding it may reach any host it can resolve, and may rewrite a captured request there.",
          "type": "boolean"
        },
        "persistentStorage": {
          "type": "boolean"
        },
        "upstreamMappingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "routingRuleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "egressGroupRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
